// Prisma Schema 文件
// 文档: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============ 核心数据模型 ============

/// 用户模型
model User {
  id        Int     @id @default(autoincrement()) @db.UnsignedInt
  email     String  @unique @db.VarChar(255)
  name      String  @db.VarChar(100) // 用户名/昵称
  password  String  @db.VarChar(255)
  // 头像可能为 URL 或 base64（长度较大），用 LongText 持久化
  avatar    String? @db.LongText
  bio       String? @db.Text
  role      String  @default("USER") @db.VarChar(50)
  isActive  Boolean @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 关系
  rooms                Room[]
  votes                Vote[]
  messages             Message[]
  notificationsReceived Notification[] @relation("NotificationTo")
  notificationsSent     Notification[] @relation("NotificationFrom")

  @@map("users")
  @@index([email])
}

/// 案件/房间模型
model Room {
  id        Int     @id @default(autoincrement()) @db.UnsignedInt
  title     String  @db.VarChar(255)
  content   String  @db.LongText
  image     String? @db.LongText // 案件头图，支持 Base64 或 URL
  status    String  @default("WAITING") @db.VarChar(50) // WAITING, LIVE, CLOSED
  
  ownerId   Int     @db.UnsignedInt
  owner     User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // 存储选中的Agent列表，如 ["bot_A", "bot_B", "bot_C"]
  agents    String  @db.Text

  viewCount Int     @default(0)
  commentCount Int @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 关系
  messages  Message[]
  votes     Vote[]

  @@map("rooms")
  @@index([ownerId])
  @@index([status])
  @@index([createdAt])
  @@fulltext([title, content])
}

/// 消息模型
model Message {
  id        Int     @id @default(autoincrement()) @db.UnsignedInt
  roomId    Int     @db.UnsignedInt
  room      Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)

  senderType String  // "AI" 或 "HUMAN"
  senderId   Int?    @db.UnsignedInt // 当为 HUMAN 时，存储用户ID；当为 AI 时，为 null
  sender     User?   @relation(fields: [senderId], references: [id], onDelete: SetNull)
  
  botId      String? @db.VarChar(255) // 当为 AI 时，存储 BotID
  
  content    String  @db.LongText
  reasoning  String? @db.LongText
  roundNumber Int?   @db.UnsignedInt

  // 回复关系（自引用）：parentId 为 null 表示顶层评论，否则为某条评论的回复
  parentId  Int?    @db.UnsignedInt
  parent    Message?  @relation("MessageReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Message[] @relation("MessageReplies")
  
  createdAt DateTime @default(now())

  @@map("messages")
  @@index([roomId])
  @@index([senderId])
  @@index([createdAt])
  @@index([roundNumber])
  @@index([parentId])
}

/// 投票模型
model Vote {
  id        Int     @id @default(autoincrement()) @db.UnsignedInt
  userId    Int     @db.UnsignedInt
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  roomId    Int     @db.UnsignedInt
  room      Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)

  agentId   String  @db.VarChar(255) // 投给了哪个Bot
  
  createdAt DateTime @default(now())

  @@unique([userId, roomId])
  @@map("votes")
  @@index([userId])
  @@index([roomId])
}

/// 评论点赞模型
model MessageLike {
  id        Int     @id @default(autoincrement()) @db.UnsignedInt
  userId    Int     @db.UnsignedInt
  messageId Int     @db.UnsignedInt

  @@unique([userId, messageId])
  @@map("message_likes")
  @@index([messageId])
}

/// 通知模型
model Notification {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  userId     Int      @db.UnsignedInt          // 接收通知的用户
  type       String   @db.VarChar(50)          // LIKE_COMMENT | NEW_COMMENT | NEW_REPLY
  fromUserId Int      @db.UnsignedInt          // 触发通知的用户
  roomId     Int      @db.UnsignedInt          // 相关案件
  messageId  Int?     @db.UnsignedInt          // 相关评论（可选）
  isRead     Boolean  @default(false)

  fromUser   User     @relation("NotificationFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  receiver   User     @relation("NotificationTo",   fields: [userId],     references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@map("notifications")
  @@index([userId])
  @@index([userId, isRead])
}

/// AI Agent 模型
model Agent {
  id           String  @id @db.VarChar(255)
  name         String  @db.VarChar(100)
  personality  String  @db.VarChar(100) // 性格特点
  description  String  @db.Text
  avatar       String? @db.VarChar(500)
  
  signature    String? @db.Text // 标志性语录/金句
  winRate      Float   @default(0.5)
  participateCount Int  @default(0)
  fans         Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("agents")
}
