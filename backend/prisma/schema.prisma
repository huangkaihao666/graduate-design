// Prisma Schema 文件
// 文档: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============ 数据模型示例 ============

/// 用户模型
model User {
  id        Int     @id @default(autoincrement()) @db.UnsignedInt
  email     String  @unique @db.VarChar(255)
  name      String  @db.VarChar(100)
  /// 绑定手机号（11 位，可选唯一）
  phone     String? @unique @db.VarChar(20)
  password  String  @db.VarChar(255)
  avatar    String? @db.LongText
  isActive  Boolean @default(true)
  /// user | worker | admin
  role      String  @default("user") @db.VarChar(20)
  /// 工作人员账号绑定本店摄影师（用于只查看该摄影师相关订单）；演示账号不绑定则为空
  workerPhotographerId Int?         @db.UnsignedInt
  workerPhotographer   Photographer? @relation("WorkerPhotographer", fields: [workerPhotographerId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 关系
  posts                          Post[]
  virtualTryOnHistories          VirtualTryOnHistory[]         @relation("VirtualTryOnHistories")
  styleRecommendationHistories   StyleRecommendationHistory[]  @relation("StyleRecommendationHistories")
  itineraryPlanningHistories     ItineraryPlanningHistory[]    @relation("ItineraryPlanningHistories")
  customerSupportHistories       CustomerSupportHistory[]      @relation("CustomerSupportHistories")
  favorites                      Favorite[]

  @@map("users")
  @@index([email])
  @@index([workerPhotographerId])
}

/// 文章模型
model Post {
  id        Int     @id @default(autoincrement()) @db.UnsignedInt
  title     String  @db.VarChar(255)
  content   String  @db.LongText
  published Boolean @default(false)

  authorId  Int     @db.UnsignedInt
  author    User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("posts")
  @@index([authorId])
}

// ============ AI 功能数据模型 ============

/// AI 虚拍历史记录
model VirtualTryOnHistory {
  id                    Int     @id @default(autoincrement()) @db.UnsignedInt

  // 输入参数
  imageUrl              String  @db.LongText
  style                 String  @db.VarChar(50)
  preferences           Json?                              // 存储 preferences 对象的 JSON

  // 输出结果
  modifiedImageUrl      String? @db.LongText
  virtualAdvice         String? @db.Text
  makeupAdvice          String? @db.Text
  hairstyleAdvice       String? @db.Text
  dressAdvice           String? @db.Text
  shootingTips          Json?                              // 存储数组的 JSON
  previewDescription    String? @db.Text

  // 用户关联（可选）
  userId                Int?    @db.UnsignedInt
  user                  User?   @relation("VirtualTryOnHistories", fields: [userId], references: [id], onDelete: SetNull)

  // 元数据
  status                String  @default("success") @db.VarChar(50) // success, failed
  errorMessage          String? @db.Text

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("virtual_try_on_histories")
  @@index([userId])
  @@index([style])
  @@index([createdAt])
}

/// AI 风格推荐历史记录
model StyleRecommendationHistory {
  id                    Int     @id @default(autoincrement()) @db.UnsignedInt

  // 输入参数
  preferences           String  @db.Text
  budget                Int?    @db.UnsignedInt
  occasions             Json?                              // 存储数组的 JSON

  // 输出结果
  recommendedStyles     Json?                              // 存储推荐风格数组的 JSON
  personalizedAdvice    String? @db.Text

  // 用户关联（可选）
  userId                Int?    @db.UnsignedInt
  user                  User?   @relation("StyleRecommendationHistories", fields: [userId], references: [id], onDelete: SetNull)

  // 元数据
  status                String  @default("success") @db.VarChar(50) // success, failed
  errorMessage          String? @db.Text

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("style_recommendation_histories")
  @@index([userId])
  @@index([createdAt])
}

/// AI 行程规划历史记录
model ItineraryPlanningHistory {
  id                    Int     @id @default(autoincrement()) @db.UnsignedInt

  // 输入参数
  destination           String  @db.VarChar(255)
  duration              Int     @db.UnsignedInt
  style                 String  @db.VarChar(50)
  interests             Json?                              // 存储数组的 JSON

  // 输出结果
  overview              String? @db.Text
  dailySchedule         Json?                              // 存储日程数组的 JSON
  packingList           Json?                              // 存储打包清单数组的 JSON
  localTips             String? @db.Text

  // 用户关联（可选）
  userId                Int?    @db.UnsignedInt
  user                  User?   @relation("ItineraryPlanningHistories", fields: [userId], references: [id], onDelete: SetNull)

  // 元数据
  status                String  @default("success") @db.VarChar(50) // success, failed
  errorMessage          String? @db.Text

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("itinerary_planning_histories")
  @@index([userId])
  @@index([destination])
  @@index([createdAt])
}

/// AI 客服问答历史记录
model CustomerSupportHistory {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  question  String   @db.Text
  answer    String   @db.LongText

  // 用户关联
  userId    Int      @db.UnsignedInt
  user      User     @relation("CustomerSupportHistories", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customer_support_histories")
  @@index([userId])
  @@index([createdAt])
}

// ============ 收藏功能数据模型 ============

/// 旅拍套餐（与用户端套餐列表、订单 packageId 一致）
model TravelPackage {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  name          String   @db.VarChar(255)
  description   String?  @db.Text
  price         Int      @db.UnsignedInt
  originalPrice Int?     @db.UnsignedInt
  duration      Int      @db.UnsignedInt
  /// 目的地（城市）：与景点 spot.city 保持一致，由 spotId 同步写入
  location      String   @db.VarChar(100)
  /// 删除景点时下架/草稿套餐会置空；仅已上架套餐会阻止删景点
  spotId        Int?     @db.UnsignedInt
  spot          Spot?    @relation(fields: [spotId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  /// 风格 key，如 romantic / artistic，与 StyleTag.key 对齐便于筛选
  style         String   @db.VarChar(50)
  coverImage    String?  @db.LongText
  images        Json?
  features      Json?
  includes      Json?
  excludes      Json?
  maxPeople     Int      @default(2) @db.UnsignedInt
  isPopular     Boolean  @default(false)
  isHot         Boolean  @default(false)
  /// draft | published | offline
  status        String   @default("draft") @db.VarChar(20)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  favorites Favorite[]

  @@map("travel_packages")
  @@index([status])
  @@index([location])
  @@index([spotId])
  @@index([style])
}

/// 景点（后台管理；套餐「目的地」必须引用景点，location = city）
model Spot {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  name        String   @db.VarChar(255)
  city        String   @db.VarChar(100)
  category    String   @db.VarChar(100)
  recommended Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  packages TravelPackage[]

  @@map("spots")
}

/// 风格标签（后台管理 + 套餐筛选）
model StyleTag {
  id        Int     @id @default(autoincrement()) @db.UnsignedInt
  key       String  @unique @db.VarChar(50)
  name      String  @db.VarChar(100)
  enabled   Boolean @default(true)
  sortOrder Int     @default(0) @db.UnsignedInt

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("style_tags")
}

/// 本店摄影师（用户端展示 + 后台维护）
model Photographer {
  id               Int     @id @default(autoincrement()) @db.UnsignedInt
  name             String  @db.VarChar(100)
  title            String? @db.VarChar(100)
  /// Base64 data URL 可能很长，与 users.avatar 一致使用 LongText
  avatar           String? @db.LongText
  /// 拍摄风格说明
  shootingStyle    String  @db.Text
  /// 从业年限（年）
  yearsExperience  Int     @default(0) @db.UnsignedInt
  bio              String? @db.Text
  /// 性别（如：男、女、其他，可空）
  gender           String? @db.VarChar(20)
  /// 年龄（周岁，可空）
  age              Int?    @db.UnsignedTinyInt
  /// 擅长题材（如：婚纱、旅拍、亲子，可多行或逗号分隔）
  specialtyTopics  String? @db.Text
  /// 资质与获奖说明
  awards           String? @db.Text
  /// 优秀作品图片 URL 列表
  portfolioImages  Json
  /// 可预约日期（ISO 日期字符串 YYYY-MM-DD 数组，JSON）
  availableDates   Json    @default("[]")
  /// 档期说明（如：每周二店休、节假日可约等）
  scheduleNote     String? @db.Text
  sortOrder        Int     @default(0) @db.UnsignedInt
  enabled          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workerAccounts User[] @relation("WorkerPhotographer")

  @@map("photographers")
  @@index([enabled, sortOrder])
}

/// 收藏模型（套餐收藏）
model Favorite {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt

  // 用户关联
  userId    Int      @db.UnsignedInt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 收藏内容（套餐ID，与 TravelPackage 一致）
  packageId Int      @db.UnsignedInt
  package   TravelPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("favorites")
  @@unique([userId, packageId]) // 确保用户不能重复收藏同一个套餐
  @@index([userId])
  @@index([packageId])
  @@index([createdAt])
}

/// 预约订单模型
model BookingOrder {
  id             Int      @id @default(autoincrement()) @db.UnsignedInt
  orderNo        String   @unique @db.VarChar(64)
  packageId      Int      @db.UnsignedInt
  packageName    String   @db.VarChar(255)
  location       String   @db.VarChar(100)
  style          String   @db.VarChar(100)
  duration       Int      @db.UnsignedInt
  unitPrice      Int      @db.UnsignedInt
  numberOfPeople Int      @db.UnsignedInt
  shootingDate   String   @db.VarChar(40)
  contactName    String   @db.VarChar(100)
  phone          String   @db.VarChar(40)
  email          String?  @db.VarChar(255)
  paymentMethod  String   @db.VarChar(30)
  remark         String?  @db.Text
  /// 用户定制方案（JSON）
  customPlan     Json?
  /// 用户指定的摄影师（可选）
  photographerId   Int?    @db.UnsignedInt
  photographerName String? @db.VarChar(100)
  totalAmount    Int      @db.UnsignedInt
  paymentStatus  String   @db.VarChar(30) // unpaid / paid / offline_pending / cancelled / completed
  paymentNo      String?  @db.VarChar(64)
  paidAt         DateTime?
  rescheduleCount           Int      @default(0) @db.UnsignedInt
  rescheduleRequestStatus   String?  @db.VarChar(30) // pending / approved / rejected
  rescheduleRequestedDate   String?  @db.VarChar(40)
  rescheduleRequestReason   String?  @db.VarChar(255)
  rescheduleRequestedAt     DateTime?
  rescheduleReviewNote      String?  @db.VarChar(255)
  rescheduleReviewedAt      DateTime?

  /// 接单工作人员用户 id（与 users.id 对应）
  workerUserId    Int?     @db.UnsignedInt
  workerType      String?  @db.VarChar(30)
  workerName      String?  @db.VarChar(100)
  workerTakenAt   DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("booking_orders")
  @@index([location])
  @@index([createdAt])
  @@index([paymentStatus])
  @@index([photographerId])
  @@index([workerUserId, createdAt])
}
