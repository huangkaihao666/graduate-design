# Server
PORT=3000
NODE_ENV=development

# CORS（frontend-react Vite 默认端口 5174，可同时保留 5173）
CORS_ORIGIN=http://localhost:5174,http://localhost:5173

# Database (MySQL) — 请确保已创建库: graduate_design
# 格式: mysql://user:password@host:port/database_name
# Mac 本机：用户名 huangkaihao，端口 3306
# DATABASE_URL=mysql://huangkaihao:hkh618618@127.0.0.1:3306/graduate-design
# Windows：用户名 root，端口 3307
# DATABASE_URL=mysql://root:hkh618618@127.0.0.1:3307/graduate-design
DATABASE_URL=mysql://huangkaihao:hkh618618@127.0.0.1:3306/graduate-design

# JWT（本地开发可保留；生产务必改为强随机值）
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-change-in-production

# Coze（调用真实 AI 时需替换为 https://www.coze.cn 的 API Key；本地仅占位以便服务启动）
