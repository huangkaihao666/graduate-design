# Server
PORT=3000
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:5173

# Database (MySQL)
# 配置格式: mysql://user:password@host:port/database_name
DATABASE_URL=mysql://root:password@localhost:3306/project_db

# JWT (待集成)
# JWT_SECRET=your_secret_key
# JWT_EXPIRATION=7d

# Redis (待集成)
# REDIS_URL=redis://localhost:6379

# Coze（辩论 / 情绪伙伴）：与火山引擎扣子同一账号下发
# COZE_API_KEY=pat_xxxxxxxx
# COZE_SPACE_ID=工作空间数字 ID（用户自建 Bot 时需配）
# 可选 COZE_SUMMARY_BOT_ID / COZE_DEFAULT_DATASET_IDS（见 README）
