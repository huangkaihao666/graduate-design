# Server
PORT=3000
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:5173

# Database (MySQL)
# 配置格式: mysql://user:password@host:port/database_name
DATABASE_URL=mysql://root:password@localhost:3306/project_db

# JWT (待集成)
# JWT_SECRET=your_secret_key
# JWT_EXPIRATION=7d

# Redis (待集成)
# REDIS_URL=redis://localhost:6379

# Coze（辩论 / 情绪伙伴）：与火山引擎扣子同一账号下发
# COZE_API_KEY=pat_xxxxxxxx
# COZE_SPACE_ID=工作空间数字 ID（用户自建 Bot 时需配）
#
# 自建智能体默认挂载的 dataset（与 /counseling 默认情绪伙伴同源；换空间后请在控制台换新 id）
# 勿包含已在控制台删除的 dataset_id，否则绑库会报 Coze 4200；换空间后请在扣子后台重新复制有效 ID
COZE_DEFAULT_DATASET_IDS=7636667369622126655,7636669370118225972,7636667778167341092,7636669013926920211,7636669370118438964
#
# 可选：覆盖代码内默认的会话摘要 Bot — COZE_SUMMARY_BOT_ID=
