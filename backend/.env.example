# DeepSeek（AI 文案/推荐等，与代码中其它模块一致）
# DEEPSEEK_API_KEY=
#
# 妆容建议「识别并填充」：DeepSeek 官方 chat 接口不支持图片，需走火山方舟图片理解
# API Key：与控制台「API Key」一致，须与推理接入点在同一项目（二选一）
# VOLCES_API_KEY=
# 或官方文档常用名：
# ARK_API_KEY=
# 在方舟控制台创建「支持图片理解」的推理接入点，将接入点 ID（一般为 ep- 开头）填到下面：
# VOLCES_VISION_CHAT_MODEL=ep-xxxx
# 可选：非北京区或自定义地址时覆盖（须与接入点地域一致）
# VOLCES_CHAT_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
#
# 若接口返回 403：多为「API Key 与 ep- 接入点不在同一项目」或 Key 未开通该模型权限，请在方舟控制台同一项目下新建 Key 并重启后端。

# 景点管理「生成描述」自动配图：Pexels（推荐，免费）https://www.pexels.com/api/
# PEXELS_API_KEY=
# 可选第二来源 Unsplash：https://unsplash.com/oauth/applications
# UNSPLASH_ACCESS_KEY=

# 可选：调用维基共享资源 API 时的 User-Agent（不配则用内置默认）
# WIKIMEDIA_USER_AGENT=YourApp/1.0 (your@email.com)

# 支付：落地页扫码（未配置微信时）
PAYMENT_PUBLIC_BASE_URL=http://localhost:5173
PAYMENT_SIGN_SECRET=change-me-to-a-long-random-string

# 微信支付 APIv3（全部配置后，在线支付将走微信 Native 真实下单；需商户号、API 证书）
# 文档：https://pay.weixin.qq.com/wiki/doc/apiv3/apis/chapter3_4_1.shtml
WECHAT_PAY_APPID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_CERT_SERIAL_NO=
# 商户 API 私钥 PEM（单行时可使用 \n 表示换行）
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_NOTIFY_URL=https://你的域名/api/v1/payments/online/notify/wechat
# APIv3 密钥（异步通知解密等场景使用）
WECHAT_PAY_API_V3_KEY=
